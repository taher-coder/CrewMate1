# Supabase project (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://ggvjvxvwjdlamqzchsom.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps Geocoding API key (server-side only — do NOT prefix with
# NEXT_PUBLIC_). Needs the Geocoding API enabled in Google Cloud Console.
# Addresses fall back to a placeholder Ahmedabad point if this is unset.
GOOGLE_MAPS_API_KEY=

# Optional. Leave unset for the main deployment (serves all four roles).
# Set to "customer", "company", or "worker" on a separate Vercel project
# to turn that deployment into a single-purpose app for just that role —
# anyone signing in there with a different role is signed out and sent
# back to /login with an explanation. Admins can sign in anywhere.
APP_SCOPE=
